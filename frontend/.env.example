# Copy to frontend/.env for local configuration. Every variable is
# optional; defaults target the Vite dev setup.

# Backend origin for API calls. Leave empty when the Vite dev proxy
# (/api -> http://localhost:8000) or same-origin serving is used.
# Examples: http://localhost:8000 | https://your-backend.example
VITE_API_BASE_URL=

# Layout-only UI fixtures without API calls ('true' to enable).
# Clearly bannered as synthetic; never used for real analysis.
VITE_DEMO_FIXTURE=false
