# Himalayan Sentinel backend environment.
# Copy to `.env` and fill locally. Never commit `.env`.
# Frontend must NOT read these; API keys live ONLY in backend env.
# Every variable is optional except MODEL_API_KEY (live analysis only).
# Names match backend/app/core/config.py (uppercase = env var).

# App
APP_ENV=dev
DATABASE_URL=sqlite:///path/to/your/database.db
STORAGE_DIR=./storage
LOG_LEVEL=INFO

# Meta Muse Spark (backend only — key never leaves the backend).
# Endpoint: POST {MUSE_SPARK_BASE_URL}/responses, model muse-spark-1.3.
MODEL_API_KEY=your_api_key
MUSE_SPARK_BASE_URL=https://api.meta.ai/v1
MUSE_SPARK_MODEL=muse-spark-1.3
MUSE_SPARK_TIMEOUT_S=60.0

# Meta SAM 3.1 segmentation. Reuses MODEL_API_KEY; no separate key.
# Endpoint: POST {SAM31_BASE_URL}/responses, model sam-3.1.
SAM31_BASE_URL=https://api.meta.ai/v1
SAM31_MODEL=sam-3.1
SAM31_TIMEOUT_S=60.0

# Upload + workflow guardrails.
MAX_IMAGE_BYTES=5242880
MAX_IMAGE_PIXELS=50000000
MAX_GEOJSON_BYTES=524288
UNIFIED_WORKFLOW_BUDGET_S=90.0

# Browser-session binding + analysis evidence cache.
SESSION_TTL_S=28800.0
ANALYSIS_CACHE_TTL_S=1800.0
ANALYSIS_CACHE_MAX_ENTRIES=100
ANALYSIS_CACHE_MAX_ENTRY_BYTES=2097152

# Browser origins allowed cross-origin (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
